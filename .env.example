ERP_CONNECTOR_PORT=3008

# Base "invoicing" de Infrastructure/ (usuario core)
ERP_CONNECTOR_MONGO_URL=mongodb://core:CLAVE@mongo:27017/invoicing?authSource=admin&replicaSet=rs0

# Token de los endpoints de este servicio (header X-Token-Admin)
ERP_CONNECTOR_ADMIN_TOKEN=

# De donde saca las conexiones al ERP, las empresas y las plantillas
CONFIG_URL=http://config:3003
# El mismo CONFIG_ADMIN_TOKEN de Config/.env
CONFIG_ADMIN_TOKEN=

# Tiempo maximo de espera al ERP
ERP_TIMEOUT_MS=60000
# Cada cuanto revisa si a alguna empresa le toca leer, y cada cuanto recarga las conexiones
PULSE_MS=5000
CONNECTIONS_REFRESH_MS=60000
